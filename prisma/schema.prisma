// prisma/schema.prisma
// Ndiaye Mikrotik — base volontairement réduite au strict nécessaire :
// ajouter un routeur (IP + identifiant + mot de passe) et l'authentification.
// Tout le reste (tickets, diagnostics, interventions, sauvegardes, clients,
// sites, audit, alertes...) a existé dans une version précédente de ce
// projet — voir l'historique git — et sera réintroduit progressivement,
// une fonctionnalité à la fois, plutôt que reconstruit d'un bloc.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  // DATABASE_URL : chaîne Accelerate (prisma+postgres://...) utilisée par
  // l'appli à l'exécution — passe par le pooling/cache géré par Prisma.
  // DIRECT_URL : connexion Postgres directe, utilisée uniquement par le CLI
  // (migrate, db push, studio) car Accelerate ne peut pas exécuter de
  // migrations. Voir .env.example.
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  SUPER_ADMIN
  ADMINISTRATEUR
  TECHNICIEN
  // Le modèle Client a disparu avec cette simplification (voir historique
  // git) — ce rôle n'a donc plus de portée particulière pour l'instant,
  // mais on le garde dans l'enum : le retirer casserait le déploiement si
  // une ligne existante l'utilise encore (Postgres refuse de supprimer une
  // valeur d'enum en cours d'usage).
  CLIENT
}

model Utilisateur {
  id          String   @id @default(cuid())
  email       String   @unique
  // Identifiant du compte Firebase Auth — Postgres reste la source de
  // vérité pour le rôle, Firebase ne fait que l'authentification.
  firebaseUid String   @unique
  nom         String
  role        Role
  actif       Boolean  @default(true)
  creeLe      DateTime @default(now())
}

model Routeur {
  id     String   @id @default(cuid())
  nom    String
  // IP joignable par la passerelle (réseau VPN) — voir gateway/README.md.
  // Jamais exposée telle quelle côté client de l'API publique.
  ipVpn  String   @unique
  creeLe DateTime @default(now())

  secret RouteurSecret?
}

// Identifiants API MikroTik, chiffrés (AES-256-GCM) — table à ne jamais
// exposer dans une réponse API ni un `select` accessible au navigateur.
// Voir lib/mikrotik/secrets.ts pour le chiffrement/déchiffrement.
model RouteurSecret {
  id                String  @id @default(cuid())
  routeur           Routeur @relation(fields: [routeurId], references: [id], onDelete: Cascade)
  routeurId         String  @unique
  utilisateurApi    String
  motDePasseChiffre String

  @@map("routeur_secrets")
}
