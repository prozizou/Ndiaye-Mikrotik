# Firebase Admin (serveur — ne jamais exposer au navigateur). Donne accès à
# la Realtime Database (données de l'app) et sert à vérifier les jetons /
# cookies de session créés par la connexion (voir NEXT_PUBLIC_FIREBASE_*
# ci-dessous et src/lib/auth/session.ts).
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# URL de la Realtime Database (onglet "Realtime Database" de la console
# Firebase, ex : https://<projet>-default-rtdb.firebaseio.com) — remplace
# Postgres/Prisma comme stockage des données de l'app (routeurs, secrets
# chiffrés).
FIREBASE_DATABASE_URL=

# Firebase Authentication (client — exposé au navigateur, ces valeurs ne
# sont pas secrètes) : utilisé uniquement par l'écran de connexion
# (email + code à 6 chiffres, voir src/app/login). Console Firebase >
# Paramètres du projet > Général > Vos applications > app Web. Le code à 6
# chiffres de chaque utilisateur est son mot de passe dans Firebase
# Authentication (à créer manuellement dans la console — Authentication >
# Users > Add user) : aucune liste blanche séparée, l'existence du compte
# dans Firebase Authentication EST l'autorisation.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=

# Chiffrement des identifiants API MikroTik (32 octets hex — openssl rand -hex 32)
MIKROTIK_SECRET_KEY=

# Passerelle MikroTik (voir gateway/README.md) — Vercel ne peut pas rester
# membre d'un tunnel WireGuard, donc tout appel REST à un routeur passe par
# ce petit relais toujours allumé sur une VPS.
# MIKROTIK_GATEWAY_URL : URL HTTPS publique de la passerelle (ex :
# https://198-51-100-10.sslip.io).
MIKROTIK_GATEWAY_URL=
# MIKROTIK_GATEWAY_SECRET : même valeur que GATEWAY_SECRET côté passerelle —
# openssl rand -hex 32.
MIKROTIK_GATEWAY_SECRET=
