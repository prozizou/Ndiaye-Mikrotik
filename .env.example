# Prisma Postgres — DATABASE_URL est la chaîne Accelerate (prisma+postgres://
# accelerate.prisma-data.net/?api_key=...) trouvée dans l'onglet "Connect" du
# projet sur console.prisma.io ; utilisée par l'appli à l'exécution.
DATABASE_URL=

# DIRECT_URL : connexion Postgres directe (postgresql://...) du même projet —
# nécessaire uniquement pour `prisma migrate` / `prisma db push` / Studio,
# Accelerate ne pouvant pas exécuter de migrations. Cherche "Direct
# connection" sur le même écran "Connect".
DIRECT_URL=

# Firebase Admin (serveur — ne jamais exposer au navigateur)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Firebase client (navigateur)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=

# Chiffrement des identifiants API MikroTik (32 octets hex — openssl rand -hex 32)
MIKROTIK_SECRET_KEY=

# Passerelle MikroTik (voir gateway/README.md) — Vercel ne peut pas rester
# membre d'un tunnel WireGuard, donc tout appel REST à un routeur passe par
# ce petit relais toujours allumé sur une VPS.
# MIKROTIK_GATEWAY_URL : URL HTTPS publique de la passerelle (ex :
# https://198-51-100-10.sslip.io).
MIKROTIK_GATEWAY_URL=
# MIKROTIK_GATEWAY_SECRET : même valeur que GATEWAY_SECRET côté passerelle —
# openssl rand -hex 32.
MIKROTIK_GATEWAY_SECRET=
