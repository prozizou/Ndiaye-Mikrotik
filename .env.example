# Firebase Admin (serveur — ne jamais exposer au navigateur). Sert
# uniquement à accéder à la Realtime Database pour l'instant : il n'y a
# aucune authentification dans l'app (retirée volontairement, voir
# historique git — à réintroduire plus tard).
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# URL de la Realtime Database (onglet "Realtime Database" de la console
# Firebase, ex : https://<projet>-default-rtdb.firebaseio.com) — remplace
# Postgres/Prisma comme stockage des données de l'app (routeurs, secrets
# chiffrés).
FIREBASE_DATABASE_URL=

# Chiffrement des identifiants API MikroTik (32 octets hex — openssl rand -hex 32)
MIKROTIK_SECRET_KEY=

# Passerelle MikroTik (voir gateway/README.md) — Vercel ne peut pas rester
# membre d'un tunnel WireGuard, donc tout appel REST à un routeur passe par
# ce petit relais toujours allumé sur une VPS.
# MIKROTIK_GATEWAY_URL : URL HTTPS publique de la passerelle (ex :
# https://198-51-100-10.sslip.io).
MIKROTIK_GATEWAY_URL=
# MIKROTIK_GATEWAY_SECRET : même valeur que GATEWAY_SECRET côté passerelle —
# openssl rand -hex 32.
MIKROTIK_GATEWAY_SECRET=
